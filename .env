# =============================================================================
#  Alapértelmezett környezeti változók — zero-config indításhoz
#  A docker compose ezt automatikusan beolvassa. NE töltsd ezt éles titkokkal!
#  (Demo célból szándékosan repóban van, hogy bárhol azonnal induljon.)
# =============================================================================

# --- PostgreSQL (adattárház) ---
POSTGRES_USER=dataeng
POSTGRES_PASSWORD=dataeng_pwd
POSTGRES_DB=warehouse

# --- MinIO (objektumtároló / data lake) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=datalake

# --- Grafana (vizualizáció) ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- ETL pipeline paraméterek ---
ETL_INTERVAL_SECONDS=20      # másodpercenkénti ciklusidő
ETL_BATCH_SIZE=250           # rendelés / ciklus
ETL_N_CUSTOMERS=600          # ügyfél törzsadat mérete
